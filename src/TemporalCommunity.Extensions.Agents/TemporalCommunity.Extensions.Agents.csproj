<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>TemporalCommunity.Extensions.Agents</AssemblyName>
    <RootNamespace>TemporalCommunity.Extensions.Agents</RootNamespace>
    <Description>Temporal integration for Microsoft Agent Framework</Description>
    <IsPackable>true</IsPackable>
    <PackageId>TemporalCommunity.Extensions.Agents</PackageId>
    <PackageTags>temporal;ai;agents;workflow;dotnet;microsoft-agent-framework</PackageTags>

    <!--
      MEAI001 is suppressed project-wide ONLY because every occurrence is in
      System.Text.Json source-generated code (AgentSessionJsonContext over AgentResponse,
      which transitively pulls in the experimental ResponseContinuationToken). Generated
      files cannot carry a `#pragma warning disable`, so this is the only lever. There is
      no hand-written consumption of an experimental MEAI API in this assembly today.
      When bumping the Microsoft.Extensions.AI version, grep this project for new direct
      MEAI usage — this NoWarn would silence it. MAAI001 is deliberately NOT here: it is
      suppressed per-file via `#pragma` so the category stays live elsewhere. Full
      inventory: Internal/ExperimentalApiSuppressions.cs · plan §2.2 (S-F-1).
    -->
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
    <!-- Analysis scoped to library projects only — test/sample projects inherit Directory.Build.props defaults. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="Temporalio.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TemporalCommunity.Extensions.AI/TemporalCommunity.Extensions.AI.csproj" />
  </ItemGroup>

  <!-- netstandard2.1 down-level support -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
    <!-- The net10 asset retains the former IReadOnlySet<T> erasure overload for binary
         compatibility. IReadOnlySet<T> does not exist on netstandard2.1, so the shared
         public-API inventory intentionally contains one net10-only symbol. -->
    <NoWarn>$(NoWarn);RS0017</NoWarn>
    <!-- Embed Polyfill shim types so they do not collide with the same types imported via
         IVT from the referenced Extensions.AI assembly. See the matching note there. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.Agents.Tests" />
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.Agents.IntegrationTests" />
  </ItemGroup>

</Project>
