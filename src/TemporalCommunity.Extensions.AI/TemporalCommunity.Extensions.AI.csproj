<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>TemporalCommunity.Extensions.AI</AssemblyName>
    <RootNamespace>TemporalCommunity.Extensions.AI</RootNamespace>
    <Description>Temporal durable execution middleware for Microsoft.Extensions.AI</Description>
    <IsPackable>true</IsPackable>
    <PackageId>TemporalCommunity.Extensions.AI</PackageId>
    <PackageTags>temporal;ai;durable;workflow;dotnet;microsoft-extensions-ai</PackageTags>
    <!-- Analysis scoped to library projects only — test/sample projects inherit Directory.Build.props defaults. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="Temporalio.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- netstandard2.1 down-level support -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
    <!-- Mark Polyfill's shim types with [Microsoft.CodeAnalysis.EmbeddedAttribute] so they
         are compiler-private and NOT importable across the assembly boundary — even through
         the [InternalsVisibleTo] this library grants to Extensions.Agents. Without this,
         Agents sees BOTH its own Polyfill copy and this assembly's via IVT, producing
         CS0436 (duplicate ExperimentalAttribute) and CS0121 (ambiguous extension methods).
         Trade-off: on the ns2.1 asset the [Experimental] diagnostic is not surfaced to
         downstream consumers (compile-time nicety only); the net10 asset uses the real BCL
         attribute and is unaffected. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.AI.Tests" />
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.AI.IntegrationTests" />
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.Agents" />
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.Agents.Tests" />
    <InternalsVisibleTo Include="TemporalCommunity.Extensions.Agents.IntegrationTests" />
  </ItemGroup>

</Project>
