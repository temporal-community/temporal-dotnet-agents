    <IsPackable>false</IsPackable>
    <UserSecretsId>c4a1d7e3-8b2f-4e05-a9c6-3f0b5d2e9a14</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/TemporalCommunity.Extensions.Agents/TemporalCommunity.Extensions.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic host: CreateApplicationBuilder, IHostedService, etc. -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
