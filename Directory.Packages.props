<Project>
  <!--
    Central Package Management (CPM) — all NuGet version pins live here.
    Individual csproj files must NOT include Version= on <PackageReference> elements.
    Tools (MinVer) keep PrivateAssets="All" in Directory.Build.props where they are referenced;
    CPM PackageVersion entries here resolve the version for every package in the repo.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Keep transitive provider packages aligned in samples and tests. The two
         packable library projects disable this so unrelated central pins are not
         promoted into their published dependency groups. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Temporal SDK -->
    <PackageVersion Include="Temporalio" Version="1.20.0" />
    <PackageVersion Include="Temporalio.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="Temporalio.Extensions.OpenTelemetry" Version="1.20.0" />
    <!-- Microsoft Agent Framework + MEAI -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- MCP is consumed only by samples/tests. Production library projects remain MCP-free. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
    <!-- OpenAI -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <!-- Testing -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Versioning tooling — MinVer; PrivateAssets="All" in Directory.Build.props -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- netstandard2.1 multi-target support (library projects only) -->
    <!-- System.Text.Json 10.0.10 matches Microsoft.Extensions.AI 10.8.3's transitive STJ dep;
         referenced only on netstandard2.1 to supply the STJ API surface for source-gen. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <!-- Analyzer (Item 11a) -->
  </ItemGroup>
</Project>