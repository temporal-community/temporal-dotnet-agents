<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped NuGet config for the down-level (netstandard2.1 asset) smoke test.
  This file is intentionally local to tests/smoke/DownLevelSmokeTest/ so it does
  NOT affect the main solution's restore. It adds the packed .nupkg output
  (artifacts/packages) as a local feed so restore + nearest-TFM asset selection
  are exercised end-to-end — the consumer sees the SAME .nupkg that ships to
  NuGet.org, not a ProjectReference.

  <clear/> drops any inherited/ambient sources so this project restores ONLY from
  the two explicit sources below (deterministic, reproducible).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packed" value="../../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
