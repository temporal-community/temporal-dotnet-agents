<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc on public member.
         CS1573: parameter without matching <param> tag.
         CS1574/CS1580: unresolvable <cref> targets in existing XML comments.
         CS1734: <paramref> tag with no matching parameter.
         CS0419: ambiguous overloaded cref.
         All are pre-existing issues now surfaced by GenerateDocumentationFile.
         TreatWarningsAsErrors is on; suppress globally so the build stays green.
         Remove individual codes here to incrementally enforce doc quality.
         TA002: intentional — dogfoods the project's own experimental API. -->
    <NoWarn>$(NoWarn);RS0016;RS0017;RS0026;CA1848;CA1873;CA2007;CA1062;CA1822;CA1725;CA1859;CA2263;CA1305;TA002;CS1591;CS1573;CS1574;CS1580;CS1734;CS0419</NoWarn>

    <Authors>Cecil Phillip</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/temporal-community/temporal-dotnet-agents</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Visible="false" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png"
          Visible="false" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
